# Microsoft Entra app-only credentials. Copy this file to .env and fill it in
# on your Mac. Find-SharedCalendarEventCreator.ps1 reads the process
# environment and, if present, .env. Never commit .env. Do not paste
# CLIENT_SECRET into chat or send it to an agent.

TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Optional. Commercial cloud defaults are shown below.
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# AUTHORITY_HOST=https://login.microsoftonline.com

# When true, query the Purview audit log for Exchange "Create" operations
# if you do not pass -Audit on the command line.
# AUDIT_FALLBACK=false
